# Railway endpoint to push translated batches to
RAILWAY_URL=https://ainews-production-9c46.up.railway.app

# Shared secret — must match INGEST_TOKEN on Railway
INGEST_TOKEN=replace-with-a-long-random-string

# Local Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# NewsAPI / GNews (optional — Google/IoT/RFID/DEV all work without them)
NEWSAPI_KEY=
GNEWS_KEY=

# Which sources to process this run (comma-separated, or "all")
# Run dev separately if you want to test
SOURCES=all

# Per-Ollama-call timeout (ms)
OLLAMA_TIMEOUT_MS=180000
